{
  "name": "senma/face-auth",
  "description": "森码云实人认证系统 - 基于AI人脸识别技术的SaaS平台",
  "type": "project",
  "license": "Apache-2.0",
  "authors": [{"name": "Senma Cloud", "email": "support@senma.cloud"}],
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-gd": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-json": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "autoload-dev": {
    "psr-4": {"App\\Tests\\": "tests/"}
  }
}